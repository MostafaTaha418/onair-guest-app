# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/.kotlin/

# Local public configuration values; only the example is committed.
/env/*.json
!/env/example.json
.env*
!.env.example

# Editor and temporary files.
*.tmp
Thumbs.db
.vscode/

# Local development tools
.tools/
**/node_modules/
